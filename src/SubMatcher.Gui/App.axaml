<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
             xmlns:local="using:SubMatcher.Gui"
             x:Class="SubMatcher.Gui.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:DataGridSemiTheme />
    <u-semi:SemiTheme Locale="zh-CN" />

    <!-- small caption above an input -->
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="2,0,0,4" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Theme" Value="{DynamicResource CardBorder}" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <!-- one line per row in result tables; the full text is one click away -->
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- dropdown lists: fade in and slide down a little every time they open -->
    <!-- (popups are re-attached on every open, so this needs a style animation, not transitions;
         TranslateTransform.Y has a built-in animator, a RenderTransform keyframe does not) -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="RenderTransform">
        <TranslateTransform />
      </Setter>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- expanders unfold instead of popping open -->
    <Style Selector="Expander">
      <Setter Property="ContentTransition">
        <local:DropDownReveal />
      </Setter>
    </Style>
    <!-- content that fades/slides in when it gets data -->
    <Style Selector=":is(Control).reveal">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(12px)" />
    </Style>
    <Style Selector=":is(Control).reveal.shown">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
  </Application.Styles>
</Application>
