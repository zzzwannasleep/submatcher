<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:local="using:SubMatcher.Gui"
        x:Class="SubMatcher.Gui.MainWindow"
        Title="SubMatcher" Icon="/Assets/icon.ico" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" DragDrop.AllowDrop="True">
  <Grid>
    <DockPanel>
      <!-- ============ top bar ============ -->
      <Border DockPanel.Dock="Top" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SemiColorBorder}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/icon.png" Width="28" Height="28" />
            <TextBlock Text="SubMatcher" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="用画面给字幕调轴" Classes="hint" VerticalAlignment="Center" Margin="4,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ThemeBtn" Theme="{DynamicResource BorderlessButton}" Content="深色模式" Click="ToggleTheme" ToolTip.Tip="切换浅色 / 深色" />
            <Button x:Name="TourBtn" Theme="{DynamicResource OutlineButton}" Content="使用引导" Click="StartTour" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl x:Name="Tabs" Theme="{DynamicResource LineTabControl}" Margin="20,8,20,16">

        <!-- ============ 画面调轴 ============ -->
        <TabItem x:Name="TabSync" Header="画面调轴">
          <Grid ColumnDefinitions="334,6,*" Margin="0,12,0,0">
            <!-- 14px gutter on the right so the scrollbar never touches the cards; the column is widened by the same amount -->
            <ScrollViewer>
              <StackPanel Spacing="12" Margin="0,0,14,0">
                <Border x:Name="FilesCard" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="h" Text="选择文件" />
                    <StackPanel>
                      <TextBlock Classes="field" Text="源视频（旧片源，字幕原本对应的视频）" />
                      <TextBox x:Name="SrcVideo" Watermark="拖入或浏览…">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="SrcVideo" Click="BrowseVideo" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="field" Text="源字幕（留空 = 使用源视频的内封字幕）" />
                      <TextBox x:Name="SrcSub" Watermark=".ass / .ssa / .srt">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Click="BrowseSrcSub" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="field" Text="目标视频（新片源，要对上的视频）" />
                      <TextBox x:Name="DstVideo" Watermark="拖入或浏览…">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="DstVideo" Click="BrowseVideo" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Classes="field" Text="输出（留空 = 目标视频同目录、同名）" />
                      <TextBox x:Name="OutSub" Watermark="自动">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="另存为" Click="BrowseOut" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Expander x:Name="AdvancedPanel" Theme="{DynamicResource CardExpander}" Header="高级参数" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,10,Auto,10,Auto,12,Auto">
                    <StackPanel>
                      <TextBlock Classes="field" Text="搜索窗口 ±秒" />
                      <NumericUpDown x:Name="OptWindow" Value="10" Minimum="1" Maximum="600" Increment="5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" ToolTip.Tip="0 = 跟随目标视频">
                      <TextBlock Classes="field" Text="分析帧率（0 = 自动）" />
                      <NumericUpDown x:Name="OptFps" Value="0" Minimum="0" Maximum="120" Increment="1" FormatString="0.###" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" ToolTip.Tip="超过则视为该行没找到（0 完全一致，1 毫不相干）">
                      <TextBlock Classes="field" Text="最大代价" />
                      <NumericUpDown x:Name="OptMaxCost" Value="0.4" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" ToolTip.Tip="超过则写进检查日志">
                      <TextBlock Classes="field" Text="提示代价" />
                      <NumericUpDown x:Name="OptWarnCost" Value="0.2" Minimum="0.01" Maximum="1" Increment="0.05" FormatString="0.00" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" ToolTip.Tip="短于此长度的行会向两边扩展取样">
                      <TextBlock Classes="field" Text="最短取样秒" />
                      <NumericUpDown x:Name="OptMinLine" Value="1.5" Minimum="0.2" Maximum="10" Increment="0.5" FormatString="0.0" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                      <TextBlock Classes="field" Text="内封字幕轨（从 0 起）" />
                      <NumericUpDown x:Name="OptStream" Value="0" Minimum="0" Maximum="99" Increment="1" />
                    </StackPanel>
                    <WrapPanel Grid.Row="6" Grid.ColumnSpan="3">
                      <ToggleSwitch x:Name="OptSnap" Content="吸附镜头切换" IsChecked="True" Margin="0,0,16,6"
                                    ToolTip.Tip="原本卡在切镜头处的时间点，调整后也卡在目标视频的切镜头处" />
                      <ToggleSwitch x:Name="OptHw" Content="硬件解码" Margin="0,0,16,6" />
                      <ToggleSwitch x:Name="OptCache" Content="缓存画面指纹" IsChecked="True" Margin="0,0,16,6" />
                    </WrapPanel>
                  </Grid>
                </Expander>

                <Grid x:Name="SyncToggles" ColumnDefinitions="*,*">
                  <ToggleSwitch x:Name="AutoCrop" Content="自动切黑边" IsChecked="True" IsCheckedChanged="AutoCropChanged"
                                ToolTip.Tip="两个视频都检测黑边（BD 有黑边 WEB 没有、或反过来），切掉后再比画面。检测结果显示在结果摘要和检查日志里" />
                  <ToggleSwitch x:Name="AutoSubset" Grid.Column="1" Content="调轴后自动子集化" IsCheckedChanged="AutoSubsetChanged"
                                ToolTip.Tip="输出的字幕直接嵌入子集化字体（会上传到字体服务器）。服务器等设置在「工具 → 字体子集化」" />
                </Grid>
                <Button x:Name="RunBtn" Theme="{DynamicResource SolidButton}" Classes="Primary Large" Content="开始调轴"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RunSync" />
                <Grid ColumnDefinitions="*,8,*">
                  <Button x:Name="CancelBtn" Content="取消" IsEnabled="False" Click="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  <Button x:Name="OpenLogBtn" Grid.Column="2" Content="检查日志" IsEnabled="False" Click="ShowCheckLog"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
                <StackPanel Spacing="6">
                  <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
                  <TextBlock x:Name="Status" Classes="hint" Text="把源视频、字幕、目标视频拖进窗口即可" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- ============ results ============ -->
            <Grid Grid.Column="2">
              <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Opacity="0.55">
                <Image Source="/Assets/icon.png" Width="72" Height="72" Opacity="0.5" />
                <TextBlock Text="结果会显示在这里" HorizontalAlignment="Center" FontSize="15" />
                <TextBlock Text="每行字幕的偏移、匹配代价与状态，可逐行对照画面并微调" Classes="hint" HorizontalAlignment="Center" />
              </StackPanel>

              <Grid x:Name="ResultsPanel" Classes="reveal" RowDefinitions="Auto,12,*" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <u:Banner x:Name="Summary" Type="Information" Header="调轴完成后，这里显示汇总" Content="共多少行、多少行需要检查、主要偏移是多少" />
                  <ToggleSwitch x:Name="OnlyCheck" Grid.Column="1" Content="只看需检查" Margin="16,0,0,0" IsCheckedChanged="FilterChanged" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,16,260">
                  <Border x:Name="ResultsCard" Classes="card" Padding="0">
                    <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" SelectionChanged="RowSelected">
                      <DataGrid.Columns>
                        <DataGridTextColumn x:DataType="local:Row" Header="原开始" Binding="{CompiledBinding OldStart}" Width="Auto" />
                        <DataGridTextColumn x:DataType="local:Row" Header="新开始" Binding="{CompiledBinding NewStart}" Width="Auto" />
                        <DataGridTextColumn x:DataType="local:Row" Header="偏移" Binding="{CompiledBinding Shift}" Width="Auto" />
                        <DataGridTextColumn x:DataType="local:Row" Header="状态" Binding="{CompiledBinding StatusText}" Width="Auto" />
                        <DataGridTextColumn x:DataType="local:Row" Header="文本" Binding="{CompiledBinding Text}" Width="*" MinWidth="120" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Border>

                  <Border x:Name="PreviewCard" Grid.Column="2" Classes="card">
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="0,0,12,0">
                        <TextBlock Classes="h" Text="对照与微调" />
                        <TextBlock Classes="hint" Text="选中行（可多选）微调后保存" />
                        <UniformGrid Columns="2" Margin="0,4,0,0">
                          <Button Content="−1 帧" Tag="-1" Click="Nudge" Margin="0,0,4,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <Button Content="+1 帧" Tag="1" Click="Nudge" Margin="4,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <Button Content="−0.5 秒" Tag="-0.5s" Click="Nudge" Margin="0,4,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <Button Content="+0.5 秒" Tag="0.5s" Click="Nudge" Margin="4,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </UniformGrid>
                        <Button Content="套用上一行的偏移" Click="CopyPrevShift" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button x:Name="SaveBtn" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="保存修改" IsEnabled="False"
                                Click="SaveEdits" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Separator Margin="0,6" />
                        <TextBlock x:Name="SrcCaption" Classes="field" Text="源" />
                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SemiColorFill0}" MinHeight="100">
                          <Image x:Name="SrcImage" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="DstCaption" Classes="field" Text="目标" />
                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SemiColorFill0}" MinHeight="100">
                          <Image x:Name="DstImage" Stretch="Uniform" />
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ============ 批量 ============ -->
        <TabItem x:Name="TabBatch" Header="批量">
          <Grid ColumnDefinitions="320,20,*" Margin="0,12,0,0">
            <StackPanel Spacing="12">
              <Border x:Name="BatchCard" Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h" Text="选择文件夹" />
                  <StackPanel>
                    <TextBlock Classes="field" Text="源目录（旧片源视频 + 同名前缀字幕，如 xx.sc.ass）" />
                    <TextBox x:Name="BatchSrc" Watermark="拖入或浏览…">
                      <TextBox.InnerRightContent>
                        <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="BatchSrc" Click="BrowseFolder" Padding="8,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="目标目录（新片源视频）" />
                    <TextBox x:Name="BatchDst" Watermark="拖入或浏览…">
                      <TextBox.InnerRightContent>
                        <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="BatchDst" Click="BrowseFolder" Padding="8,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="field" Text="输出目录（留空 = 目标目录）" />
                    <TextBox x:Name="BatchOut" Watermark="自动">
                      <TextBox.InnerRightContent>
                        <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="BatchOut" Click="BrowseFolder" Padding="8,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>
                  <TextBlock Classes="hint" Text="按集数配对（认不出集数时按文件名顺序）；没有外挂字幕的视频使用内封字幕。调轴参数沿用「画面调轴」页的高级参数。" />
                </StackPanel>
              </Border>
              <Button Content="预览配对" Click="ScanBatch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="BatchRunBtn" Theme="{DynamicResource SolidButton}" Classes="Primary Large" Content="开始批量调轴"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RunBatch" />
              <Button x:Name="BatchCancelBtn" Content="取消" IsEnabled="False" Click="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="1" />
            </StackPanel>
            <Border Grid.Column="2" Classes="card" Padding="4">
              <TextBox x:Name="BatchLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" Watermark="配对结果和处理日志会显示在这里" />
            </Border>
          </Grid>
        </TabItem>

        <!-- ============ 字幕下载与改名 ============ -->
        <TabItem x:Name="TabSubs" Header="下载与改名">
          <Grid ColumnDefinitions="*,16,*" Margin="0,12,0,0">
            <Border x:Name="TgCard" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h" Text="Telegram 字幕频道" />
                    <TextBlock x:Name="TgStatus" Classes="hint" Text="未登录（检索和下载需要扫码登录一次）" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="TgLoginBtn" Grid.Column="1" Theme="{DynamicResource OutlineButton}" Content="扫码登录" Click="TgLogin" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="220,8,*,8,Auto">
                  <ComboBox x:Name="TgChannel" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{x:Static local:MainWindow.Channels}"
                            ToolTip.Tip="新番：anime_chinese_subtitles；合辑/旧番：anime_chinese_subtitles_old；非日本动画：chinese_subtitles" />
                  <TextBox x:Name="TgQuery" Grid.Column="2" Watermark="片名关键词（简繁体都可以试试）" KeyDown="TgQueryKey" />
                  <Button x:Name="TgSearchBtn" Grid.Column="4" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="检索" Click="TgSearch" MinWidth="72" />
                </Grid>
                <TextBlock Grid.Row="2" Classes="hint" Text="按「片名 + 平台」合并，不分集；选一组下载该平台的全部简体 / 繁体字幕" TextWrapping="Wrap" />
                <ListBox x:Name="TgGroups" Grid.Row="3" MinHeight="160" SelectionMode="Single" SelectionChanged="TgGroupSelected" />
                <Grid Grid.Row="4" ColumnDefinitions="Auto,8,*,8,Auto">
                  <ComboBox x:Name="TgLang" SelectedIndex="0" MinWidth="96">
                    <ComboBoxItem Content="简体" />
                    <ComboBoxItem Content="繁体" />
                    <ComboBoxItem Content="简繁都要" />
                  </ComboBox>
                  <TextBox x:Name="TgOut" Grid.Column="2" Watermark="保存到（留空 = 程序目录/字幕下载/片名 [平台]）">
                    <TextBox.InnerRightContent>
                      <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="TgOut" Click="BrowseFolder" Padding="8,0" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="TgDownloadBtn" Grid.Column="4" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="下载" Click="TgDownload" MinWidth="72" />
                </Grid>
                <StackPanel Grid.Row="5" Spacing="6">
                  <ProgressBar x:Name="TgProgress" Minimum="0" Maximum="1" IsVisible="False" />
                  <TextBlock x:Name="TgLog" Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="RenameCard" Grid.Column="2" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h" Text="字幕自动改名" />
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="按集数把字幕改成视频的名字，播放器就会自动加载。每集每种语言选一个：子集化过的优先，其次最新的。" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                  <TextBlock Classes="field" Text="视频文件夹" />
                  <TextBox x:Name="RenVideos" Watermark="拖入或浏览…">
                    <TextBox.InnerRightContent>
                      <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="RenVideos" Click="BrowseFolder" Padding="8,0" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="2">
                  <TextBlock Classes="field" Text="字幕文件夹（留空 = 视频文件夹）" />
                  <TextBox x:Name="RenSubs" Watermark="拖入或浏览…">
                    <TextBox.InnerRightContent>
                      <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="RenSubs" Click="BrowseFolder" Padding="8,0" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                </StackPanel>
                <Grid Grid.Row="3" ColumnDefinitions="*,8,*">
                  <StackPanel ToolTip.Tip="视频名.sc.ass；留空 = 不加后缀">
                    <TextBlock Classes="field" Text="简体后缀" />
                    <TextBox x:Name="RenSc" Text="sc" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="field" Text="繁体后缀" />
                    <TextBox x:Name="RenTc" Text="tc" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,8,Auto">
                  <WrapPanel VerticalAlignment="Center">
                    <ToggleSwitch x:Name="RenCopy" Content="复制（保留原文件）" Margin="0,0,16,4" />
                    <ToggleSwitch x:Name="RenBackup" Content="备份原字幕" IsChecked="True" Margin="0,0,16,4" ToolTip.Tip="改名或被覆盖的字幕先复制到「字幕备份」文件夹" />
                  </WrapPanel>
                  <Button Grid.Column="1" Content="预览" Click="RenamePreview" VerticalAlignment="Center" />
                  <Button x:Name="RenameBtn" Grid.Column="3" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="改名" Click="RenameRun" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="5" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="6">
                  <!-- read-only text, top-aligned (Semi's TextBox centres short content vertically) -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="RenLog" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12"
                                         Foreground="{DynamicResource SemiColorText2}" Text="预览：原字幕 → 新名字" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- ============ 工具 ============ -->
        <TabItem x:Name="TabTools" Header="工具">
          <ScrollViewer Margin="0,12,0,0">
            <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="field" Text="字幕文件（.ass / .ssa / .srt，任意编码）" />
                  <TextBox x:Name="ToolSub" Watermark="拖入或浏览…">
                    <TextBox.InnerRightContent>
                      <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Click="BrowseToolSub" Padding="8,0" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h" Text="整体 / 区间平移" />
                  <TextBlock Classes="hint" Text="填「偏移」直接平移；或者填同一句话在旧片源与新片源中的时间，自动算偏移。区间留空 = 全部行。时间格式 0:10:35.20 / 10:35 / 635.2" />
                  <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel>
                      <TextBlock Classes="field" Text="偏移（秒）" />
                      <TextBox x:Name="ShiftOffset" Watermark="-1.5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="field" Text="或：原时间" />
                      <TextBox x:Name="ShiftFrom" Watermark="0:10:35.00" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Classes="field" Text="→ 目标时间" />
                      <TextBox x:Name="ShiftTo" Watermark="0:12:03.00" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel>
                      <TextBlock Classes="field" Text="只处理开始时间 ≥" />
                      <TextBox x:Name="RangeStart" Watermark="（开头）" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="field" Text="且 &lt;" />
                      <TextBox x:Name="RangeEnd" Watermark="（结尾）" />
                    </StackPanel>
                    <Button Grid.Column="4" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="平移" Click="ToolShift"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,12,*">
                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="h" Text="帧率转换" />
                    <TextBlock Classes="hint" Text="同一批帧换播放速度，如 PAL 25 → 23.976" />
                    <Grid ColumnDefinitions="*,8,*,8,Auto">
                      <ComboBox x:Name="FpsFrom" IsEditable="True" Text="25" ItemsSource="{x:Static local:MainWindow.CommonFps}" HorizontalAlignment="Stretch" />
                      <ComboBox x:Name="FpsTo" Grid.Column="2" IsEditable="True" Text="23.976" ItemsSource="{x:Static local:MainWindow.CommonFps}" HorizontalAlignment="Stretch" />
                      <Button Grid.Column="4" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="转换" Click="ToolFps" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="h" Text="编码转换" />
                    <TextBlock Classes="hint" Text="自动识别 UTF-8 / UTF-16 / GBK / BIG5，另存为 UTF-8 BOM（覆盖原文件）" />
                    <Button Theme="{DynamicResource SolidButton}" Classes="Primary" Content="转为 UTF-8" Click="ToolEncode" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border x:Name="FitCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h" Text="比例调整（黑边适配）" />
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="字幕是按没有黑边的画面做的（如 PlayRes 1920×816），视频却带黑边（1920×1080），播放时字会被拉伸、屏幕字跑进黑边。检测视频黑边后把字幕挪回画面里：字号不变，坐标整体平移。调轴时两边黑边不同会自动做这一步。" />
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Classes="field" Text="视频（用来检测黑边）" />
                      <TextBox x:Name="FitVideo" Watermark="拖入或浏览…">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Click="BrowseFitVideo" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="field" Text="字幕（留空 = 视频里的内封 ASS）" />
                      <TextBox x:Name="FitSub" Watermark="拖入或浏览…">
                        <TextBox.InnerRightContent>
                          <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Click="BrowseFitSub" Padding="8,0" />
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <ToggleSwitch x:Name="FitInPlace" Content="覆盖原字幕" VerticalAlignment="Center"
                                  ToolTip.Tip="关掉时输出 xx.fit.ass；内封字幕总是输出到视频旁边：视频名.sc.ass / .tc.ass" />
                    <Button x:Name="FitBtn" Grid.Column="1" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="调整"
                            Click="ToolFit" VerticalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center" />
                  </Grid>
                  <SelectableTextBlock x:Name="FitLog" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
              </Border>

              <Border x:Name="ZhCard" Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h" Text="简繁转换" />
                    <HyperlinkButton Grid.Column="1" Content="由繁化姬 zhconvert.org 提供" NavigateUri="https://zhconvert.org" Padding="0" FontSize="12" />
                  </Grid>
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="整份字幕交给繁化姬转换：只转对白，样式、特效标签、字体名不动。「中国化 / 台湾化」连用语一起换（软件 ↔ 軟體）。输出文件名里的 CHS/CHT、sc/tc 会跟着换，原文件保留。" />
                  <StackPanel>
                    <TextBlock Classes="field" Text="字幕或文件夹（留空 = 上面的字幕文件）" />
                    <TextBox x:Name="ZhInput" Watermark="拖入文件夹或浏览…">
                      <TextBox.InnerRightContent>
                        <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="ZhInput" Click="BrowseFolder" Padding="8,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <ComboBox x:Name="ZhMode" MinWidth="220" SelectedIndex="1" ItemsSource="{x:Static local:MainWindow.ZhModes}" />
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                      <ToggleSwitch x:Name="ZhRecursive" Content="包含子文件夹" Margin="0,0,16,0" />
                      <ToggleSwitch x:Name="ZhInPlace" Content="覆盖原文件" />
                    </WrapPanel>
                    <Button x:Name="ZhBtn" Grid.Column="3" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="转换"
                            Click="ToolZh" VerticalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center" />
                  </Grid>
                  <ProgressBar x:Name="ZhProgress" Minimum="0" Maximum="1" IsVisible="False" />
                  <SelectableTextBlock x:Name="ZhLog" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
              </Border>

              <Border x:Name="SubsetCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h" Text="字体子集化" />
                  <TextBlock Classes="hint" Text="把字幕用到的字体精简成只含这些字的子集，嵌进字幕里，没装字体的播放器也能正常显示。字幕会上传到下面的 FontInAss 服务器处理。" />
                  <StackPanel>
                    <TextBlock Classes="field" Text="字幕或文件夹（留空 = 上面的字幕文件）" />
                    <TextBox x:Name="SubsetInput" Watermark="拖入文件夹或浏览…">
                      <TextBox.InnerRightContent>
                        <Button Theme="{DynamicResource BorderlessButton}" Content="浏览" Tag="SubsetInput" Click="BrowseFolder" Padding="8,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>
                  <Grid ColumnDefinitions="2*,12,*,12,*">
                    <StackPanel>
                      <TextBlock Classes="field" Text="服务器" />
                      <TextBox x:Name="SubsetServer" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" ToolTip.Tip="公共服务器不需要">
                      <TextBlock Classes="field" Text="API Key（可选）" />
                      <TextBox x:Name="SubsetApiKey" PasswordChar="•" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" ToolTip.Tip="多条字幕内封进同一个 MKV 时，每条填不同的值（如 SC / TC），避免字体别名冲突">
                      <TextBlock Classes="field" Text="别名盐（可选）" />
                      <TextBox x:Name="SubsetSalt" Watermark="SC" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel VerticalAlignment="Center">
                      <ToggleSwitch x:Name="SubsetRecursive" Content="包含子文件夹" Margin="0,0,16,4" />
                      <ToggleSwitch x:Name="SubsetInPlace" Content="覆盖原文件" Margin="0,0,16,4" ToolTip.Tip="关掉时输出为 xx.subset.ass" />
                      <ToggleSwitch x:Name="SubsetClean" Content="清除已嵌入的字体" Margin="0,0,16,4" ToolTip.Tip="已经子集化过的字幕要重新处理时打开" />
                      <ToggleSwitch x:Name="SubsetStrict" Content="缺字体算失败" Margin="0,0,16,4" />
                    </WrapPanel>
                    <Button x:Name="SubsetBtn" Grid.Column="1" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="子集化"
                            Click="ToolSubset" VerticalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center" />
                  </Grid>
                  <ProgressBar x:Name="SubsetProgress" Minimum="0" Maximum="1" IsVisible="False" />
                  <SelectableTextBlock x:Name="SubsetLog" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="ToolStatus" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ============ 设置 ============ -->
        <TabItem x:Name="TabSettings" Header="设置">
          <ScrollViewer Margin="0,12,0,0">
            <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
              <Border x:Name="UpdateCard" Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h" Text="版本" />
                    <TextBlock x:Name="UpdateInfo" Classes="hint" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" IsVisible="False" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button x:Name="UpdateBtn" Grid.Column="1" Theme="{DynamicResource SolidButton}" Classes="Primary" Content="检查更新"
                          Click="CheckUpdate" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h" Text="Telegram 代理" />
                  <TextBlock Classes="hint" Text="连不上 Telegram 时填本地代理，如 socks5://主机:端口（Clash / v2rayN 的混合端口），或 MTProxy 链接。留空 = 直连" TextWrapping="Wrap" />
                  <TextBox x:Name="TgProxy" Watermark="socks5://主机:端口" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h" Text="画面指纹缓存" />
                    <TextBlock x:Name="CacheInfo" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Theme="{DynamicResource OutlineButton}" Classes="Danger" Content="清空缓存" Click="ClearCache" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>

    <local:TourOverlay x:Name="Tour" />
  </Grid>
</Window>
