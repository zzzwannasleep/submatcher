<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SubMatcher.Gui"
        x:Class="SubMatcher.Gui.MainWindow"
        Title="SubMatcher — 画面调轴" Width="1180" Height="800" MinWidth="820" MinHeight="560"
        DragDrop.AllowDrop="True">
  <TabControl x:Name="Tabs" Margin="8">

    <!-- ============ 画面调轴 ============ -->
    <TabItem Header="画面调轴">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="4">
        <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
          <TextBlock Classes="label" Text="源视频" />
          <TextBox x:Name="SrcVideo" Grid.Column="1" Watermark="旧片源（TV / Web），字幕原本对应的视频。可直接把文件拖进窗口" />
          <Button Grid.Column="2" Content="浏览…" Tag="SrcVideo" Click="BrowseVideo" />

          <TextBlock Grid.Row="1" Classes="label" Text="源字幕" />
          <TextBox x:Name="SrcSub" Grid.Row="1" Grid.Column="1" Watermark="留空 = 使用源视频的内封字幕" />
          <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Click="BrowseSrcSub" />

          <TextBlock Grid.Row="2" Classes="label" Text="目标视频" />
          <TextBox x:Name="DstVideo" Grid.Row="2" Grid.Column="1" Watermark="新片源（BD），要对上的视频" />
          <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Tag="DstVideo" Click="BrowseVideo" />

          <TextBlock Grid.Row="3" Classes="label" Text="输出字幕" />
          <TextBox x:Name="OutSub" Grid.Row="3" Grid.Column="1" Watermark="留空 = 目标视频同目录、同名" />
          <Button Grid.Row="3" Grid.Column="2" Content="另存为…" Click="BrowseOut" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
          <StackPanel Classes="opt" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="搜索窗口 ±秒" Margin="0,0,4,0" />
            <NumericUpDown x:Name="OptWindow" Value="10" Minimum="1" Maximum="600" Increment="5" />
            <TextBlock Text="分析帧率" ToolTip.Tip="0 = 跟随目标视频" />
            <NumericUpDown x:Name="OptFps" Value="0" Minimum="0" Maximum="120" Increment="1" FormatString="0.###" />
            <TextBlock Text="最大代价" ToolTip.Tip="超过则视为该行没找到（0 完全一致，1 毫不相干）" />
            <NumericUpDown x:Name="OptMaxCost" Value="0.4" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" />
            <TextBlock Text="提示代价" ToolTip.Tip="超过则写进检查日志" />
            <NumericUpDown x:Name="OptWarnCost" Value="0.2" Minimum="0.01" Maximum="1" Increment="0.05" FormatString="0.00" />
          </StackPanel>
          <StackPanel Classes="opt" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="最短取样秒" Margin="0,0,4,0" ToolTip.Tip="短于此长度的行会向两边扩展取样" />
            <NumericUpDown x:Name="OptMinLine" Value="1.5" Minimum="0.2" Maximum="10" Increment="0.5" FormatString="0.0" />
            <TextBlock Text="内封字幕轨" />
            <NumericUpDown x:Name="OptStream" Value="0" Minimum="0" Maximum="99" Increment="1" />
            <CheckBox x:Name="OptSnap" Content="吸附镜头切换" IsChecked="True" Margin="12,0,0,0" ToolTip.Tip="原本卡在切镜头处的时间点，调整后也卡在目标视频的切镜头处" />
            <CheckBox x:Name="OptHw" Content="硬件解码" Margin="12,0,0,0" />
            <CheckBox x:Name="OptCache" Content="缓存画面指纹" IsChecked="True" Margin="12,0,0,0" />
          </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,8">
          <Button x:Name="RunBtn" Content="开始调轴" Classes="accent" Click="RunSync" />
          <Button x:Name="CancelBtn" Grid.Column="1" Content="取消" IsEnabled="False" Click="Cancel" />
          <Button x:Name="OpenLogBtn" Grid.Column="2" Content="查看检查日志" IsEnabled="False" Click="ShowCheckLog" />
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="6" />
            <TextBlock x:Name="Status" Text="把源视频、字幕、目标视频拖进窗口即可" FontSize="12" Margin="0,4,0,0" Opacity="0.8" />
          </StackPanel>
          <CheckBox x:Name="OnlyCheck" Grid.Column="4" Content="只看需检查的行" IsCheckedChanged="FilterChanged" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,6,380">
          <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal" SelectionChanged="RowSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50" />
              <DataGridTextColumn Header="原开始" Binding="{Binding OldStart}" Width="100" />
              <DataGridTextColumn Header="新开始" Binding="{Binding NewStart}" Width="100" />
              <DataGridTextColumn Header="偏移" Binding="{Binding Shift}" Width="85" />
              <DataGridTextColumn Header="代价" Binding="{Binding Cost}" Width="65" />
              <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="140" />
              <DataGridTextColumn Header="文本" Binding="{Binding Text}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="6" Margin="6,0,0,0">
              <TextBlock Text="手动微调选中行（可多选）" FontWeight="SemiBold" />
              <WrapPanel>
                <Button Content="−1 帧" Tag="-1" Click="Nudge" Margin="0,0,6,6" />
                <Button Content="+1 帧" Tag="1" Click="Nudge" Margin="0,0,6,6" />
                <Button Content="−0.5 秒" Tag="-0.5s" Click="Nudge" Margin="0,0,6,6" />
                <Button Content="+0.5 秒" Tag="0.5s" Click="Nudge" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel>
                <Button Content="套用上一行的偏移" Click="CopyPrevShift" Margin="0,0,6,6" />
                <Button x:Name="SaveBtn" Content="保存修改" Classes="accent" IsEnabled="False" Click="SaveEdits" Margin="0,0,6,6" />
              </WrapPanel>
              <TextBlock Text="画面对照（选中行的中点）" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock x:Name="SrcCaption" Text="源" FontSize="12" Opacity="0.8" />
              <Border Background="#20808080" MinHeight="120"><Image x:Name="SrcImage" Stretch="Uniform" MaxHeight="200" /></Border>
              <TextBlock x:Name="DstCaption" Text="目标" FontSize="12" Opacity="0.8" />
              <Border Background="#20808080" MinHeight="120"><Image x:Name="DstImage" Stretch="Uniform" MaxHeight="200" /></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============ 批量 ============ -->
    <TabItem Header="批量">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="4">
        <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
          <TextBlock Classes="label" Text="源目录" />
          <TextBox x:Name="BatchSrc" Grid.Column="1" Watermark="旧片源视频 + 字幕（字幕与视频同名前缀，如 xx.sc.ass / xx.tc.ass）" />
          <Button Grid.Column="2" Content="浏览…" Tag="BatchSrc" Click="BrowseFolder" />
          <TextBlock Grid.Row="1" Classes="label" Text="目标目录" />
          <TextBox x:Name="BatchDst" Grid.Row="1" Grid.Column="1" Watermark="新片源视频" />
          <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Tag="BatchDst" Click="BrowseFolder" />
          <TextBlock Grid.Row="2" Classes="label" Text="输出目录" />
          <TextBox x:Name="BatchOut" Grid.Row="2" Grid.Column="1" Watermark="留空 = 输出到目标目录" />
          <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Tag="BatchOut" Click="BrowseFolder" />
        </Grid>
        <TextBlock Grid.Row="1" Margin="0,8" FontSize="12" Opacity="0.8"
                   Text="按集数配对（认不出集数时按文件名顺序）；没有外挂字幕的视频会使用内封字幕。调轴参数沿用「画面调轴」页。" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="预览配对" Click="ScanBatch" />
          <Button x:Name="BatchRunBtn" Content="开始批量调轴" Classes="accent" Click="RunBatch" />
          <Button x:Name="BatchCancelBtn" Content="取消" IsEnabled="False" Click="Cancel" />
          <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="1" Width="260" Height="6" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox x:Name="BatchLog" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 TextWrapping="NoWrap" />
      </Grid>
    </TabItem>

    <!-- ============ 工具 ============ -->
    <TabItem Header="工具">
      <ScrollViewer>
        <StackPanel Margin="4" MaxWidth="900" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="6" Margin="0,0,0,12">
            <TextBlock Classes="label" Text="字幕文件" />
            <TextBox x:Name="ToolSub" Grid.Column="1" Watermark=".ass / .ssa / .srt，任意编码" />
            <Button Grid.Column="2" Content="浏览…" Click="BrowseToolSub" />
          </Grid>

          <StackPanel Classes="section"><TextBlock Classes="h" Text="整体 / 区间平移" />
            <StackPanel Spacing="6">
              <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                         Text="填「偏移」直接平移；或者填同一句话在旧片源与新片源中的时间，自动算偏移。区间留空 = 全部行。时间格式 0:10:35.20 / 10:35 / 635.2" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="label" Text="偏移(秒)" />
                <TextBox x:Name="ShiftOffset" Width="110" Watermark="-1.5" />
                <TextBlock Classes="label" Text="或  原时间" Margin="12,0,8,0" />
                <TextBox x:Name="ShiftFrom" Width="120" Watermark="0:10:35.00" />
                <TextBlock Classes="label" Text="→ 目标时间" />
                <TextBox x:Name="ShiftTo" Width="120" Watermark="0:12:03.00" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="label" Text="只处理开始时间在" />
                <TextBox x:Name="RangeStart" Width="120" Watermark="(开头)" />
                <TextBlock Classes="label" Text="到" />
                <TextBox x:Name="RangeEnd" Width="120" Watermark="(结尾)" />
                <TextBlock Classes="label" Text="之间的行" />
                <Button Content="平移" Classes="accent" Click="ToolShift" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Classes="section"><TextBlock Classes="h" Text="帧率转换（同一批帧换播放速度，如 PAL 25 → 23.976）" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="label" Text="源帧率" />
              <ComboBox x:Name="FpsFrom" Width="130" IsEditable="True" Text="25" ItemsSource="{x:Static local:MainWindow.CommonFps}" />
              <TextBlock Classes="label" Text="→ 目标帧率" />
              <ComboBox x:Name="FpsTo" Width="130" IsEditable="True" Text="23.976" ItemsSource="{x:Static local:MainWindow.CommonFps}" />
              <Button Content="转换" Classes="accent" Click="ToolFps" />
            </StackPanel>
          </StackPanel>

          <StackPanel Classes="section"><TextBlock Classes="h" Text="编码转换" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="label" Text="自动识别 UTF-8 / UTF-16 / GBK / BIG5，另存为 UTF-8 BOM（覆盖原文件）" />
              <Button Content="转为 UTF-8" Classes="accent" Click="ToolEncode" />
            </StackPanel>
          </StackPanel>

          <StackPanel Classes="section"><TextBlock Classes="h" Text="缓存" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="CacheInfo" Classes="label" />
              <Button Content="清空画面指纹缓存" Click="ClearCache" />
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="ToolStatus" TextWrapping="Wrap" Margin="0,4" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
